{
  "enabled": true,
  "features": {
    "transcribe": true,
    "meetingNotes": true
  },
  "hotkey": {
    "shortcut": "RightCtrl",
    "suppress": true
  },
  "audio": {
    "deviceId": "default",
    "maxSeconds": 90
  },
  "transcription": {
    "provider": "local",
    "language": "en",
    "fallbackToLocal": true,
    "localModelPath": "models/ggml-small.en.bin",
    "localThreads": 0,
    "openaiModel": "gpt-4o-transcribe",
    "groqModel": "whisper-large-v3-turbo",
    "azureRegion": "",
    "azureLocale": "en-US"
  },
  "cleanup": {
    "provider": "basic",
    "model": "",
    "azureEndpoint": "",
    "style": "auto",
    "fallbackToBasic": true
  },
  "paste": {
    "restoreClipboard": true,
    "restoreDelayMs": 175
  },
  "meetingNotes": {
    "outputDirectory": "~/MeetingNotes",
    "transcriptionProvider": "auto",
    "language": "en",
    "localModelPath": "models/ggml-medium.en.bin",
    "localThreads": 0,
    "openaiTranscriptionModel": "gpt-4o-transcribe",
    "groqTranscriptionModel": "whisper-large-v3-turbo",
    "notesProvider": "auto",
    "openaiNotesModel": "gpt-4.1-mini",
    "groqNotesModel": "openai/gpt-oss-120b",
    "ollamaEndpoint": "http://127.0.0.1:11434",
    "ollamaModel": "llama3.2:3b"
  },
  "launchAtLogin": false
}

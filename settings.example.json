{
  "enabled": true,
  "hotkey": {
    "shortcut": "RightCtrl",
    "suppress": true
  },
  "audio": {
    "deviceId": "default",
    "maxSeconds": 90
  },
  "inference": {
    "devicePriority": [
      "npu",
      "gpu",
      "cpu"
    ]
  },
  "transcription": {
    "provider": "windowsml",
    "language": "en",
    "fallbackToLocal": true,
    "fallbackToOnline": true,
    "onlineProvider": "openai",
    "windowsMlModel": "whisper-tiny",
    "acceleratedModelPath": "models/whisper-base.en-int8-ov",
    "localModelPath": "models/ggml-small.en.bin",
    "localThreads": 0,
    "openaiModel": "gpt-4o-transcribe",
    "groqModel": "whisper-large-v3-turbo",
    "azureRegion": "",
    "azureLocale": "en-US"
  },
  "cleanup": {
    "provider": "windowsml",
    "model": "",
    "windowsMlModel": "qwen2.5-0.5b",
    "onlineModel": "gpt-4o-mini",
    "onlineProvider": "openai",
    "localModel": "gemma3:1b",
    "localEndpoint": "http://127.0.0.1:11434/v1",
    "azureEndpoint": "",
    "style": "auto",
    "fallbackToOnline": true,
    "fallbackToBasic": true
  },
  "paste": {
    "restoreClipboard": true,
    "restoreDelayMs": 175
  },
  "launchAtLogin": false
}

<Window x:Class="Whispdows.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="156"
        MaxWidth="420"
        Height="40"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="Width"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Border x:Name="PillBorder"
            MinWidth="156"
            MaxWidth="420"
            Padding="14,0"
            Background="#F01B1E26"
            BorderBrush="#4DFFFFFF"
            BorderThickness="1"
            CornerRadius="20">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="Indicator"
                       VerticalAlignment="Center"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#FF71D7A5"
                       Text="●" />
            <TextBlock x:Name="Message"
                       MaxWidth="350"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="White"
                       Text="Listening…"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.ToolTip>
                    <ToolTip Content="{Binding Text, ElementName=Message}" />
                </TextBlock.ToolTip>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>

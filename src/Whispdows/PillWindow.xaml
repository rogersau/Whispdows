<Window x:Class="Whispdows.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="160"
        Height="36"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Border x:Name="PillBorder"
            Padding="12,0"
            Background="#E61B1B1F"
            BorderBrush="#4DFFFFFF"
            BorderThickness="1"
            CornerRadius="18">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="Indicator"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="#FF71D7A5"
                       Text="●" />
            <TextBlock x:Name="Message"
                       Margin="7,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="White"
                       Text="Listening…" />
        </StackPanel>
    </Border>
</Window>

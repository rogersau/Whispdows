<Window x:Class="Whispdows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Whispdows Settings"
        Width="760"
        Height="760"
        MinWidth="620"
        MinHeight="600"
        Background="#0E1118"
        Foreground="#ECF2FF"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        PreviewKeyUp="Window_OnPreviewKeyUp"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECF2FF" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#171C27" />
            <Setter Property="BorderBrush" Value="#35425A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#ECF2FF" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#171C27" />
            <Setter Property="BorderBrush" Value="#35425A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#ECF2FF" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="#171C27" />
            <Setter Property="BorderBrush" Value="#35425A" />
            <Setter Property="Foreground" Value="#ECF2FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                          Padding="{TemplateBinding Padding}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <Grid>
                                                <TextBlock VerticalAlignment="Center"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           Text="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=SelectedItem.Content}" />
                                                <Path Width="9"
                                                      Height="5"
                                                      Margin="0,0,2,0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4.5 5 L 9 0 Z"
                                                      Fill="{TemplateBinding Foreground}"
                                                      Stretch="Fill" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#38D9F5" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#38D9F5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                        Background="#171C27"
                                        BorderBrush="#405170"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <ScrollViewer MaxHeight="280"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Popup" Property="MinHeight" Value="20" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleButton" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#171C27" />
            <Setter Property="Foreground" Value="#ECF2FF" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#087F9E" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="#ECF2FF" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="14,10,14,14" />
            <Setter Property="BorderBrush" Value="#2E3A50" />
            <Setter Property="Foreground" Value="#ECF2FF" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="#202A3D" />
            <Setter Property="BorderBrush" Value="#405170" />
            <Setter Property="Foreground" Value="#ECF2FF" />
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Text="Settings" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="#9AA8C2"
                           Text="Tune the voice loop without touching JSON." />
            </StackPanel>
            <TextBlock HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#38D9F5"
                       Text="WHISPDOWS" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="General">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Shortcut" />
                        <TextBox x:Name="ShortcutBox"
                                 Grid.Column="1"
                                 IsReadOnly="True" />
                        <Button x:Name="RecordHotkeyButton"
                                Grid.Column="2"
                                Click="RecordHotkeyButton_OnClick"
                                Content="Record hotkey" />
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="3"
                                   Margin="0,4,0,0"
                                   Foreground="#8997B0"
                                   Text="Click Record hotkey, then press the key or combination you want. Escape cancels." />
                        <CheckBox x:Name="SuppressBox"
                                  Grid.Row="2"
                                  Grid.ColumnSpan="3"
                                  Content="Suppress the shortcut while dictation is active" />
                        <CheckBox x:Name="EnabledBox"
                                  Grid.Row="3"
                                  Grid.ColumnSpan="3"
                                  Content="Enable dictation after applying settings" />
                        <CheckBox x:Name="LaunchAtLoginBox"
                                  Grid.Row="4"
                                  Grid.ColumnSpan="3"
                                  Content="Launch Whispdows when I sign in" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Audio">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Device" />
                        <ComboBox x:Name="AudioDeviceBox" Grid.Column="1" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Maximum seconds" />
                        <TextBox x:Name="MaxSecondsBox" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Transcription">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Provider" />
                            <ComboBox x:Name="TranscriptionProviderBox"
                                      Grid.Column="1"
                                      SelectionChanged="TranscriptionProviderBox_OnSelectionChanged">
                                <ComboBoxItem Content="local" />
                                <ComboBoxItem Content="azure" />
                                <ComboBoxItem Content="openai" />
                                <ComboBoxItem Content="groq" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Language" />
                            <TextBox x:Name="LanguageBox" Grid.Row="1" Grid.Column="1" />
                        </Grid>
                        <CheckBox x:Name="FallbackLocalBox"
                                  Content="Fall back to local Whisper if cloud transcription fails" />

                        <Border x:Name="LocalTranscriptionPanel"
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="#131925"
                                BorderBrush="#26324A"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Local model path" />
                                <TextBox x:Name="LocalModelPathBox" Grid.Column="1" />
                                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="CPU threads" />
                                <TextBox x:Name="LocalThreadsBox" Grid.Row="1" Grid.Column="1" />
                            </Grid>
                        </Border>

                        <Border x:Name="OpenAiTranscriptionPanel"
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="#131925"
                                BorderBrush="#26324A"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="OpenAI model" />
                                <TextBox x:Name="OpenAiModelBox" Grid.Column="1" />
                            </Grid>
                        </Border>

                        <Border x:Name="GroqTranscriptionPanel"
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="#131925"
                                BorderBrush="#26324A"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Groq model" />
                                <TextBox x:Name="GroqModelBox" Grid.Column="1" />
                            </Grid>
                        </Border>

                        <Border x:Name="AzureTranscriptionPanel"
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="#131925"
                                BorderBrush="#26324A"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Azure region" />
                                <TextBox x:Name="AzureRegionBox" Grid.Column="1" />
                                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Azure locale" />
                                <TextBox x:Name="AzureLocaleBox" Grid.Row="1" Grid.Column="1" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="API keys">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="OpenAI" />
                        <StackPanel Grid.Column="1">
                            <DockPanel>
                                <CheckBox x:Name="ClearOpenAiApiKeyBox"
                                          DockPanel.Dock="Right"
                                          Content="Clear key" />
                                <PasswordBox x:Name="OpenAiApiKeyBox" />
                            </DockPanel>
                            <TextBlock x:Name="OpenAiApiKeyStatus"
                                       Margin="0,3,0,0"
                                       Foreground="#8997B0" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Groq" />
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <DockPanel>
                                <CheckBox x:Name="ClearGroqApiKeyBox"
                                          DockPanel.Dock="Right"
                                          Content="Clear key" />
                                <PasswordBox x:Name="GroqApiKeyBox" />
                            </DockPanel>
                            <TextBlock x:Name="GroqApiKeyStatus"
                                       Margin="0,3,0,0"
                                       Foreground="#8997B0" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Azure" />
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <DockPanel>
                                <CheckBox x:Name="ClearAzureApiKeyBox"
                                          DockPanel.Dock="Right"
                                          Content="Clear key" />
                                <PasswordBox x:Name="AzureApiKeyBox" />
                            </DockPanel>
                            <TextBlock x:Name="AzureApiKeyStatus"
                                       Margin="0,3,0,0"
                                       Foreground="#8997B0" />
                        </StackPanel>
                        <TextBlock Grid.Row="3"
                                   Grid.ColumnSpan="2"
                                   Margin="0,10,0,0"
                                   Foreground="#8997B0"
                                   Text="Keys are encrypted with Windows DPAPI for this user. Leave a field blank to keep its current key." />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Cleanup">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Provider" />
                            <ComboBox x:Name="CleanupProviderBox"
                                      Grid.Column="1"
                                      SelectionChanged="CleanupProviderBox_OnSelectionChanged">
                                <ComboBoxItem Content="basic" />
                                <ComboBoxItem Content="azure-openai" />
                                <ComboBoxItem Content="openai" />
                                <ComboBoxItem Content="groq" />
                                <ComboBoxItem Content="none" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Style" />
                            <ComboBox x:Name="CleanupStyleBox" Grid.Row="1" Grid.Column="1">
                                <ComboBoxItem Content="auto" />
                                <ComboBoxItem Content="sentence" />
                                <ComboBoxItem Content="fragment" />
                            </ComboBox>
                        </Grid>

                        <Border x:Name="CloudCleanupPanel"
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="#131925"
                                BorderBrush="#26324A"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Model / deployment" />
                                <TextBox x:Name="CleanupModelBox" Grid.Column="1" />
                            </Grid>
                        </Border>

                        <Border x:Name="AzureCleanupPanel"
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="#131925"
                                BorderBrush="#26324A"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Azure v1 endpoint" />
                                <TextBox x:Name="AzureEndpointBox" Grid.Column="1" />
                            </Grid>
                        </Border>

                        <CheckBox x:Name="FallbackBasicBox"
                                  Content="Fall back to basic cleanup if the cloud cleanup fails" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Paste">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="RestoreClipboardBox"
                                  Grid.ColumnSpan="2"
                                  Content="Restore the previous clipboard after pasting" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Restore delay (ms)" />
                        <TextBox x:Name="RestoreDelayBox" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ErrorBorder"
                    Padding="10,8"
                    Background="#321E222B"
                    BorderBrush="#FFB85C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                <TextBlock x:Name="ErrorText"
                           Foreground="#FFFFC777"
                           TextWrapping="Wrap" />
            </Border>
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Click="CancelButton_OnClick"
                    IsCancel="True"
                    Content="Cancel" />
            <Button x:Name="ApplyButton"
                    Grid.Column="2"
                    Background="#087F9E"
                    BorderBrush="#2ED9F2"
                    Click="ApplyButton_OnClick"
                    Content="Save &amp; Apply" />
        </Grid>
    </Grid>
</Window>

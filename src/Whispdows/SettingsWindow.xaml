<Window x:Class="Whispdows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Whispdows Settings"
        Width="800"
        Height="820"
        MinWidth="480"
        MinHeight="520"
        Background="#0E1118"
        FontFamily="Segoe UI Variable Text"
        Foreground="#ECF2FF"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        PreviewKeyUp="Window_OnPreviewKeyUp"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECF2FF" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#171C27" />
            <Setter Property="BorderBrush" Value="#35425A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#ECF2FF" />
            <Setter Property="CaretBrush" Value="#ECF2FF" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#38D9F5" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#171C27" />
            <Setter Property="BorderBrush" Value="#35425A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#ECF2FF" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="#171C27" />
            <Setter Property="BorderBrush" Value="#35425A" />
            <Setter Property="Foreground" Value="#ECF2FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                          Padding="{TemplateBinding Padding}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <Grid>
                                                <TextBlock VerticalAlignment="Center"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           Text="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=SelectedItem.Content}" />
                                                <Path Width="9"
                                                      Height="5"
                                                      Margin="0,0,2,0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4.5 5 L 9 0 Z"
                                                      Fill="{TemplateBinding Foreground}"
                                                      Stretch="Fill" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#38D9F5" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#38D9F5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                        Background="#171C27"
                                        BorderBrush="#405170"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <ScrollViewer MaxHeight="280"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Popup" Property="MinHeight" Value="20" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleButton" Property="Opacity" Value="0.55" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="#38D9F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#171C27" />
            <Setter Property="Foreground" Value="#ECF2FF" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#087F9E" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="#ECF2FF" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,5,12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#D8E1F2" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="16,14,16,16" />
            <Setter Property="Background" Value="#121722" />
            <Setter Property="BorderBrush" Value="#2E3A50" />
            <Setter Property="Foreground" Value="#ECF2FF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border Margin="0,9,0,0"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <ContentPresenter />
                            </Border>
                            <Border Margin="16,0,0,0"
                                    Padding="7,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="#121722">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#B9C8E3"
                                           Text="{TemplateBinding Header}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="#202A3D" />
            <Setter Property="BorderBrush" Value="#405170" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#ECF2FF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#38D9F5" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#28354C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#7CEBFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PresetButtonStyle"
               BasedOn="{StaticResource {x:Type Button}}"
               TargetType="Button">
            <Setter Property="Margin" Value="0,8,8,0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock FontSize="29"
                           FontWeight="SemiBold"
                           Text="Settings" />
                <TextBlock Margin="0,5,0,0"
                            Foreground="#9AA8C2"
                            Text="Choose how Whispdows listens, cleans up, and pastes your dictation." />
            </StackPanel>
            <TextBlock HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#38D9F5"
                       Text="LOCAL-FIRST DICTATION" />
        </Grid>

        <ScrollViewer x:Name="SettingsScroll"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="General">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Target="{Binding ElementName=ShortcutBox}" Content="_Shortcut" />
                        <TextBox x:Name="ShortcutBox" Grid.Column="1" IsReadOnly="True" />
                        <Button x:Name="RecordHotkeyButton"
                                Grid.Column="2"
                                Click="RecordHotkeyButton_OnClick"
                                Content="Record hotkey" />
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="3"
                                   Margin="0,4,0,0"
                                   Foreground="#8997B0"
                                   Text="Click Record hotkey, then press the key or combination you want. Escape cancels." />
                        <CheckBox x:Name="SuppressBox"
                                  Grid.Row="2"
                                  Grid.ColumnSpan="3"
                                  Content="Suppress the shortcut while dictation is active" />
                        <CheckBox x:Name="EnabledBox"
                                  Grid.Row="3"
                                  Grid.ColumnSpan="3"
                                  Content="Enable dictation after applying settings" />
                        <CheckBox x:Name="LaunchAtLoginBox"
                                  Grid.Row="4"
                                  Grid.ColumnSpan="3"
                                  Content="Launch Whispdows when I sign in" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Audio">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Target="{Binding ElementName=AudioDeviceBox}" Content="_Microphone" />
                        <ComboBox x:Name="AudioDeviceBox"
                                  Grid.Column="1"
                                  ToolTip="Choose the Windows input device used for dictation." />
                        <Label Grid.Row="1"
                               Target="{Binding ElementName=MaxSecondsBox}"
                               Content="Maximum _recording (seconds)" />
                        <TextBox x:Name="MaxSecondsBox" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="API keys">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label VerticalAlignment="Center" Content="OpenAI" />
                        <StackPanel Grid.Column="1">
                            <DockPanel>
                                <CheckBox x:Name="ClearOpenAiApiKeyBox"
                                          DockPanel.Dock="Right"
                                          Content="Clear key" />
                                <PasswordBox x:Name="OpenAiApiKeyBox" />
                            </DockPanel>
                            <TextBlock x:Name="OpenAiApiKeyStatus"
                                       Margin="0,3,0,0"
                                       Foreground="#8997B0" />
                        </StackPanel>
                        <Label Grid.Row="1" VerticalAlignment="Center" Content="Groq" />
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <DockPanel>
                                <CheckBox x:Name="ClearGroqApiKeyBox"
                                          DockPanel.Dock="Right"
                                          Content="Clear key" />
                                <PasswordBox x:Name="GroqApiKeyBox" />
                            </DockPanel>
                            <TextBlock x:Name="GroqApiKeyStatus"
                                       Margin="0,3,0,0"
                                       Foreground="#8997B0" />
                        </StackPanel>
                        <Label Grid.Row="2" VerticalAlignment="Center" Content="Azure" />
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <DockPanel>
                                <CheckBox x:Name="ClearAzureApiKeyBox"
                                          DockPanel.Dock="Right"
                                          Content="Clear key" />
                                <PasswordBox x:Name="AzureApiKeyBox" />
                            </DockPanel>
                            <TextBlock x:Name="AzureApiKeyStatus"
                                       Margin="0,3,0,0"
                                       Foreground="#8997B0" />
                        </StackPanel>
                        <TextBlock Grid.Row="3"
                                   Grid.ColumnSpan="2"
                                   Margin="0,10,0,0"
                                   Foreground="#8997B0"
                                   Text="Keys are encrypted with Windows DPAPI for this user. Leave a field blank to keep its current key." />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Transcription">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Target="{Binding ElementName=TranscriptionProviderBox}"
                                   Content="_Provider" />
                            <ComboBox x:Name="TranscriptionProviderBox"
                                      Grid.Column="1"
                                      SelectionChanged="TranscriptionProviderBox_OnSelectionChanged">
                                <ComboBoxItem Tag="local" Content="Local Whisper (offline)" />
                                <ComboBoxItem Tag="azure" Content="Azure Speech" />
                                <ComboBoxItem Tag="openai" Content="OpenAI" />
                                <ComboBoxItem Tag="groq" Content="Groq" />
                            </ComboBox>
                            <Label Grid.Row="1"
                                   Target="{Binding ElementName=LanguageBox}"
                                   Content="_Language code" />
                            <TextBox x:Name="LanguageBox" Grid.Row="1" Grid.Column="1" />
                        </Grid>
                        <CheckBox x:Name="FallbackLocalBox"
                                  Content="Fall back to local Whisper if cloud transcription fails" />

                        <Border x:Name="LocalTranscriptionPanel"
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="#131925"
                                BorderBrush="#26324A"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Target="{Binding ElementName=LocalModelPathBox}"
                                       Content="Whisper model _path" />
                                <TextBox x:Name="LocalModelPathBox"
                                         Grid.Column="1"
                                         ToolTip="Relative paths are resolved from the Whispdows application folder." />
                                <Label Grid.Row="1"
                                       Target="{Binding ElementName=LocalThreadsBox}"
                                       Content="CPU _threads" />
                                <TextBox x:Name="LocalThreadsBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         ToolTip="Use 0 to let Whispdows choose automatically." />
                            </Grid>
                        </Border>

                        <Border x:Name="OpenAiTranscriptionPanel"
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="#131925"
                                BorderBrush="#26324A"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label Target="{Binding ElementName=OpenAiModelBox}"
                                       Content="OpenAI _model" />
                                <TextBox x:Name="OpenAiModelBox" Grid.Column="1" />
                            </Grid>
                        </Border>

                        <Border x:Name="GroqTranscriptionPanel"
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="#131925"
                                BorderBrush="#26324A"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label Target="{Binding ElementName=GroqModelBox}"
                                       Content="Groq _model" />
                                <TextBox x:Name="GroqModelBox" Grid.Column="1" />
                            </Grid>
                        </Border>

                        <Border x:Name="AzureTranscriptionPanel"
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="#131925"
                                BorderBrush="#26324A"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Target="{Binding ElementName=AzureRegionBox}"
                                       Content="Azure _region" />
                                <TextBox x:Name="AzureRegionBox" Grid.Column="1" />
                                <Label Grid.Row="1"
                                       Target="{Binding ElementName=AzureLocaleBox}"
                                       Content="Azure _locale" />
                                <TextBox x:Name="AzureLocaleBox" Grid.Row="1" Grid.Column="1" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Cleanup">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Target="{Binding ElementName=CleanupProviderBox}"
                                   Content="_Provider" />
                            <ComboBox x:Name="CleanupProviderBox"
                                      Grid.Column="1"
                                      SelectionChanged="CleanupProviderBox_OnSelectionChanged">
                                <ComboBoxItem Tag="basic" Content="Basic cleanup (offline)" />
                                <ComboBoxItem Tag="ollama" Content="Local AI model (Ollama)" />
                                <ComboBoxItem Tag="azure-openai" Content="Azure OpenAI" />
                                <ComboBoxItem Tag="openai" Content="OpenAI" />
                                <ComboBoxItem Tag="groq" Content="Groq" />
                                <ComboBoxItem Tag="none" Content="No cleanup" />
                            </ComboBox>
                            <Label x:Name="CleanupStyleLabel"
                                   Grid.Row="1"
                                   Target="{Binding ElementName=CleanupStyleBox}"
                                   Content="Basic cleanup _style" />
                            <ComboBox x:Name="CleanupStyleBox" Grid.Row="1" Grid.Column="1">
                                <ComboBoxItem Tag="auto" Content="Automatic" />
                                <ComboBoxItem Tag="sentence" Content="Complete sentences" />
                                <ComboBoxItem Tag="fragment" Content="Natural fragments" />
                            </ComboBox>
                        </Grid>

                        <Border x:Name="LocalCleanupPanel"
                                Margin="0,12,0,0"
                                Padding="14"
                                Background="#131925"
                                BorderBrush="#2B4960"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="#DDEAFF"
                                           Text="Tiny local cleanup model" />
                                <TextBlock Margin="0,4,0,8"
                                           Foreground="#91A2BD"
                                           Text="Gemma 3 1B is the balanced default. The 270M model is smaller and faster, but may miss harder corrections."
                                           TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Target="{Binding ElementName=LocalCleanupModelBox}"
                                           Content="_Model name" />
                                    <TextBox x:Name="LocalCleanupModelBox"
                                             Grid.Column="1"
                                             TextChanged="LocalCleanupModelBox_OnTextChanged"
                                             ToolTip="Any model available to your local OpenAI-compatible runtime." />
                                    <Label Grid.Row="1"
                                           Target="{Binding ElementName=LocalCleanupEndpointBox}"
                                           Content="Local _endpoint" />
                                    <TextBox x:Name="LocalCleanupEndpointBox"
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             ToolTip="Only a loopback address such as 127.0.0.1 or localhost is accepted." />
                                </Grid>
                                <WrapPanel>
                                    <Button Style="{StaticResource PresetButtonStyle}"
                                            Tag="gemma3:1b"
                                            Click="LocalModelPresetButton_OnClick"
                                            Content="Gemma 3 1B · recommended" />
                                    <Button Style="{StaticResource PresetButtonStyle}"
                                            Tag="gemma3:270m"
                                            Click="LocalModelPresetButton_OnClick"
                                            Content="Gemma 3 270M · smallest" />
                                    <Button Style="{StaticResource PresetButtonStyle}"
                                            Tag="qwen2.5:0.5b"
                                            Click="LocalModelPresetButton_OnClick"
                                            Content="Qwen 2.5 0.5B" />
                                    <Button Style="{StaticResource PresetButtonStyle}"
                                            Tag="qwen2.5:1.5b"
                                            Click="LocalModelPresetButton_OnClick"
                                            Content="Qwen 2.5 1.5B" />
                                    <Button Style="{StaticResource PresetButtonStyle}"
                                            Tag="qwen3:1.7b"
                                            Click="LocalModelPresetButton_OnClick"
                                            Content="Qwen 3 1.7B" />
                                </WrapPanel>
                                <Border Margin="0,10,0,0"
                                        Padding="10,8"
                                        Background="#192333"
                                        CornerRadius="6">
                                    <TextBlock x:Name="LocalSetupHint"
                                               FontFamily="Cascadia Mono"
                                               FontSize="12"
                                               Foreground="#B6C8E5"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CloudCleanupPanel"
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="#131925"
                                BorderBrush="#26324A"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label Target="{Binding ElementName=CleanupModelBox}"
                                       Content="Model / _deployment" />
                                <TextBox x:Name="CleanupModelBox" Grid.Column="1" />
                            </Grid>
                        </Border>

                        <Border x:Name="AzureCleanupPanel"
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="#131925"
                                BorderBrush="#26324A"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label Target="{Binding ElementName=AzureEndpointBox}"
                                       Content="Azure _v1 endpoint" />
                                <TextBox x:Name="AzureEndpointBox" Grid.Column="1" />
                            </Grid>
                        </Border>

                        <CheckBox x:Name="FallbackBasicBox"
                                  Checked="FallbackBasicBox_OnChanged"
                                  Unchecked="FallbackBasicBox_OnChanged"
                                  Content="Fall back to basic cleanup if AI cleanup is unavailable" />
                        <TextBlock x:Name="CleanupPrivacyText"
                                   Margin="0,10,0,0"
                                   Foreground="#8997B0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Paste">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="RestoreClipboardBox"
                                  Grid.ColumnSpan="2"
                                  Content="Restore the previous clipboard after pasting" />
                        <Label Grid.Row="1"
                               Target="{Binding ElementName=RestoreDelayBox}"
                               Content="Restore _delay (ms)" />
                        <TextBox x:Name="RestoreDelayBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 ToolTip="How long Whispdows waits before restoring the previous clipboard." />
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ErrorBorder"
                    Padding="10,8"
                    AutomationProperties.LiveSetting="Assertive"
                    Background="#321E222B"
                    BorderBrush="#FFB85C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                <TextBlock x:Name="ErrorText"
                           Foreground="#FFFFC777"
                           TextWrapping="Wrap" />
            </Border>
            <StackPanel x:Name="SaveProgress"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Margin="0,0,0,5"
                           FontSize="12"
                           Foreground="#9FB0CB"
                           Text="Applying settings…" />
                <ProgressBar Width="150"
                             Height="3"
                             HorizontalAlignment="Left"
                             IsIndeterminate="True" />
            </StackPanel>
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Click="CancelButton_OnClick"
                    IsCancel="True"
                    Content="Cancel" />
            <Button x:Name="ApplyButton"
                    Grid.Column="2"
                    Background="#087F9E"
                    BorderBrush="#2ED9F2"
                    Click="ApplyButton_OnClick"
                    IsDefault="True"
                    Content="Save &amp; Apply" />
        </Grid>
    </Grid>
</Window>
